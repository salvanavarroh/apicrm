# Supabase — proyecto en Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CLI: PAT desde dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=

# App URL (para emails de invitación, OAuth callbacks, etc.)
# En dev: http://localhost:3000 — en prod: https://app.tudominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bootstrap del primer SuperAdmin (Sprint 1, `pnpm seed:super-admin`)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Resend — emails transaccionales (Sprint 1+)
RESEND_API_KEY=

# Sentry — observabilidad (Sprint 0/1)
SENTRY_DSN=

# Cron — secret para que el endpoint /api/cron/* solo acepte llamadas auth.
# En Vercel, configurar como env var. Cron de Vercel manda Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Mensajería omnicanal (Zernio) — WhatsApp + Meta Lead Ads.
# API key server-only (Bearer). Secret propio para verificar la firma de los webhooks
# (HMAC-SHA256), distinto de CRON_SECRET. Se completan al activar las fases de mensajería.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
