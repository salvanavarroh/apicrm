# Supabase — proyecto en Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CLI: PAT desde dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=

# App URL (para emails de invitación, OAuth callbacks, etc.)
# En dev: http://localhost:3000 — en prod: https://app.tudominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bootstrap del primer SuperAdmin (Sprint 1, `pnpm seed:super-admin`)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Resend — emails transaccionales (Sprint 1+)
RESEND_API_KEY=

# Sentry — observabilidad (Sprint 0/1)
SENTRY_DSN=

# Cron — secret para que el endpoint /api/cron/* solo acepte llamadas auth.
# En Vercel, configurar como env var. Cron de Vercel manda Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Mensajería omnicanal (Zernio) — WhatsApp + Meta Lead Ads.
# API key server-only (Bearer). Secret propio para verificar la firma de los webhooks
# (HMAC-SHA256), distinto de CRON_SECRET. Se completan al activar las fases de mensajería.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# OpenAI — importación de leads con IA, bot del inbox y ASISTENTE DEL CRM.
# Server-only. Sin esta key el asistente sigue contestando permisos, navegación
# y datos (las rutas deterministas), pero no responde preguntas de producto ni
# se puede indexar la base de conocimiento.
OPENAI_API_KEY=

# --- Motorbox ---------------------------------------------------------------
# Integración con el marketplace. Todas opcionales: sin ellas la integración se
# apaga sola (el ítem del menú no aparece, los endpoints devuelven 503).
# Generar el par de claves y los secretos con: ./scripts/motorbox-setup-keys.sh
#
# Claves del ticket SSO (RS256). PEM en base64: Vercel maneja mal los saltos de
# línea de una env var multilínea. La PRIVADA no se comparte con nadie.
MOTORBOX_JWT_PRIVATE_KEY_B64=
MOTORBOX_JWT_PUBLIC_KEY_B64=
MOTORBOX_JWT_KID=

# Credenciales de partner. Las dos primeras las generamos nosotros y se las
# damos a Motorbox; las dos últimas nos las dan ellos.
MOTORBOX_PARTNER_KEY=
MOTORBOX_WEBHOOK_SECRET=
API_CRM_PARTNER_KEY=
API_CRM_WEBHOOK_SECRET=

# Orígenes. El del CRM sale de NEXT_PUBLIC_APP_URL (arriba) y va CON www:
# es el `iss` del ticket y Motorbox lo compara exacto.
MOTORBOX_PUBLIC_ORIGIN=https://www.motorbox.ai
NEXT_PUBLIC_MOTORBOX_EMBED_ORIGIN=https://motorbox.apicrm.ai

# Ingesta de leads server-to-server (CTA que no son WhatsApp). Apagada en v1:
# el único CTA de Motorbox es WhatsApp y ese lead entra por el inbox.
MOTORBOX_LEAD_INGEST_ENABLED=false
