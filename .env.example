# Supabase — proyecto en Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (para emails de invitación, OAuth callbacks, etc.)
# En dev: http://localhost:3000 — en prod: https://app.tudominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — emails transaccionales (Sprint 1+)
RESEND_API_KEY=

# Sentry — observabilidad (Sprint 0/1)
SENTRY_DSN=
